# Copy to .env and fill in. Never commit .env.
API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# WORKPLACEOPS_OFFLINE=1

# MongoDB persistence (Phase 1). For Atlas use the SRV string; URL-encode special characters in the password.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=workplaceops
# required = writes must succeed or the API returns 503; disabled = run without a database
WORKPLACEOPS_PERSISTENCE=required

# Portal auth (role-based UI). The admin account is created/updated from these at API startup.
# Users register themselves in the UI. Use a strong password; never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_NAME=Operations Admin
# ADMIN_EMAIL=admin@workplaceops.local
# SESSION_TTL_HOURS=8

# Phase 2 approvers (demo auth only - not production identity). Server-configured; users can't self-register as approvers.
# Format: username:password[,username2:password2]. Admins cannot approve; nobody can approve their own request.
APPROVER_ACCOUNTS=
